# Copy to .env for deployment. Never commit this filled file.
# Shell variables override .env values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
JARVIS_APP_ORIGIN=
JARVIS_GITHUB_CLIENT_ID=
JARVIS_ALLOWED_GITHUB_IDS=
JARVIS_WORKER_NAME=jarvis-routine-assistant
JARVIS_GITHUB_CLIENT_SECRET=
CLOUDFLARE_API_TOKEN=
# Keep OAuth client secret in .dev.vars locally / Cloudflare secrets in production.
